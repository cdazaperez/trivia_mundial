# Secret key for JWT tokens - CHANGE THIS in production
SECRET_KEY=generate-a-strong-random-key-here

# Port where the app will be accessible (default: 80)
APP_PORT=80

# Admin user (created automatically on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@triviamundial.com
ADMIN_FULLNAME=Administrador
